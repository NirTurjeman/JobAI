# /etc/webtracker/webtracker.env  (root:webtracker, mode 0640). No secrets here —
# the bot token is provided via LoadCredential (see the .service files).
WT_DATA_DIR=/var/lib/webtracker
WT_RESEARCH_CONFIG=/etc/webtracker/research.yaml
WT_LOG_LEVEL=INFO
WT_AGENT_BACKEND=codex
WT_CODEX_BINARY=/usr/local/bin/codex
WT_CODEX_HOME=/home/webtracker/.codex
WT_CODEX_TIMEOUT_SECONDS=1800
WT_TELEGRAM_ALLOWED_USER_ID=000000000
WT_NOTIFICATIONS_ENABLED=true
HOME=/home/webtracker
