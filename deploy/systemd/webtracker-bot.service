[Unit]
Description=webtracker Telegram bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=webtracker
Group=webtracker
WorkingDirectory=/opt/webtracker
EnvironmentFile=/etc/webtracker/webtracker.env
LoadCredential=WT_TELEGRAM_BOT_TOKEN:/etc/webtracker/credentials/telegram_bot_token
ExecStart=/opt/webtracker/.venv/bin/webtracker bot
Restart=on-failure
RestartSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/webtracker /home/webtracker/.codex
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
